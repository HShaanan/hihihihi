# --- Model auth: choose ONE of the two options below ---

# Option A: Vertex AI (recommended for production on Google Cloud).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option B: Gemini API key (simpler for local dev). If you use this,
# set GOOGLE_GENAI_USE_VERTEXAI=FALSE and provide the key:
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-gemini-api-key
