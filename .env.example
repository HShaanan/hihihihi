# --- אימות מול המודל: בחרו אחת משתי האפשרויות ---

# אפשרות א': Vertex AI (מומלץ לפרודקשן ב-Google Cloud).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# אפשרות ב': מפתח Gemini API (פשוט יותר לפיתוח מקומי). אם משתמשים בזה,
# הגדירו GOOGLE_GENAI_USE_VERTEXAI=FALSE וספקו את המפתח:
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-gemini-api-key
